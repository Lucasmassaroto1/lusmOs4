# lusmOS 4 - tela de boot (Plymouth script)
# So o fundo escuro e o pontinho girando: o logo aparece uma vez so, na animacao
# que o lusmOS toca quando abre (antes o logo aparecia aqui, no video e de novo no lusmOS).
Window.SetBackgroundTopColor(0.027, 0.031, 0.047);
Window.SetBackgroundBottomColor(0.027, 0.031, 0.047);

ox = Window.GetX() + (Window.GetWidth() - 640) / 2;
oy = Window.GetY() + (Window.GetHeight() - 480) / 2;

dot.image = Image("dot.png");
dot.sprite = Sprite(dot.image);
dot.sprite.SetZ(2);

angle = 0;
fun refresh_callback ()
  {
    angle = angle + 0.08;
    dot.sprite.SetX(ox + 320 + 66 * Math.Sin(angle) - 5);
    dot.sprite.SetY(oy + 190 - 66 * Math.Cos(angle) - 5);
  }
Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback (text) { }
Plymouth.SetMessageFunction(message_callback);
